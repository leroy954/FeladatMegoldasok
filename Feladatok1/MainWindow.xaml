<Window x:Class="AlapfeladatokWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Programozás alapfeladatok"
        Width="1060" Height="780" MinWidth="920" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#EDF0F5" Foreground="#233047"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DFE5ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#68768D"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Background" Value="#F8FAFD"/>
            <Setter Property="Foreground" Value="#233047"/>
            <Setter Property="BorderBrush" Value="#D4DDEA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Keretezes" CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Keretezes" Property="BorderBrush" Value="#92A9CA"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Keretezes" Property="BorderBrush" Value="#4269CD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#F8FAFD"/>
            <Setter Property="Foreground" Value="#233047"/>
            <Setter Property="BorderBrush" Value="#D4DDEA"/>
            <Setter Property="MaxDropDownHeight" Value="330"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style x:Key="Gomb" TargetType="Button">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Background" Value="#4269CD"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GombKeret" CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GombKeret" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="GombKeret" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="GombKeret" Property="BorderBrush" Value="#172F66"/>
                                <Setter TargetName="GombKeret" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="GombKeret" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1F2D45" CornerRadius="18" Padding="26,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="54" Height="54" CornerRadius="14" Background="#34486C" Margin="0,0,18,0">
                    <TextBlock Text="" Foreground="#BFD0FF" FontFamily="Consolas"
                               FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Programozás alapfeladatok" FontSize="25"
                               FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Válassz feladatot, add meg az adatokat, és nézd meg az eredményt."
                               Foreground="#B8C5DB" Margin="0,5,16,0" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="2" Background="#34486C" CornerRadius="16"
                        Padding="14,7" VerticalAlignment="Center">
                    <TextBlock Text="31 FELADAT" Foreground="#DAE4FF" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="1.08*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="01 / FELADAT KIVÁLASZTÁSA" Style="{StaticResource Caption}"/>
                        <ComboBox x:Name="FeladatComboBox" Margin="0,12,0,18"
                                  SelectionChanged="FeladatComboBox_SelectionChanged"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#EFF4FF" CornerRadius="10" Padding="14" Margin="0,0,0,20">
                        <TextBlock x:Name="LeirasTextBlock" TextWrapping="Wrap"
                                   Foreground="#385080" FontSize="13"/>
                    </Border>
                    <TextBlock Grid.Row="2" Text="02 / BEMENETI ADATOK"
                               Style="{StaticResource Caption}" Margin="0,0,0,12"/>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,0">
                            <StackPanel x:Name="ElsoPanel" Margin="0,0,0,12">
                                <TextBlock x:Name="ElsoLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="ElsoTextBox" ToolTip="Írd be az első adatot!"/>
                            </StackPanel>
                            <StackPanel x:Name="MasodikPanel" Margin="0,0,0,12">
                                <TextBlock x:Name="MasodikLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="MasodikTextBox" ToolTip="Írd be a második adatot!"/>
                            </StackPanel>
                            <StackPanel x:Name="HarmadikPanel" Margin="0,0,0,12">
                                <TextBlock x:Name="HarmadikLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="HarmadikTextBox" ToolTip="Írd be a harmadik adatot!"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="4" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="FuttatButton" Grid.Column="0" Content="Megoldás"
                                Style="{StaticResource Gomb}" Click="FuttatButton_Click"/>
                        <Button Grid.Column="2" Content="Újrakezdés" Style="{StaticResource Gomb}"
                                Background="#EDF1F7" Foreground="#465773"
                                Click="UjraButton_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="03 / EREDMÉNY" Style="{StaticResource Caption}"/>
                    <TextBlock Grid.Row="1" Text="A megoldásod" FontSize="21"
                               FontWeight="SemiBold" Margin="0,10,0,18"/>
                    <Grid Grid.Row="2">
                        <TextBox x:Name="EredmenyTextBox" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 Background="#F5F7FB" Padding="16" FontFamily="Consolas"
                                 FontSize="14" VerticalContentAlignment="Top"/>
                        <TextBlock Text="Az eredmény itt jelenik meg."
                                   Foreground="#718099" Margin="17" IsHitTestVisible="False" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=EredmenyTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Grid.Row="3" Text="Az eredményt kijelölheted és Ctrl+C-vel másolhatod."
                               Foreground="#718099" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="4,18,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="C# · WPF · Gyakorlófelület" Foreground="#718099" FontSize="12"/>
            <TextBlock Grid.Column="1" Text="Tizedes szám: ponttal vagy vesszővel is megadható."
                       Foreground="#718099" FontSize="12"/>
        </Grid>
    </Grid>
</Window>
